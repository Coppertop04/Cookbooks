minor_breaks = log2_minor_breaks) +
labs(x = "M value to Standard",
y = "-log10 p value",
color = "Expression status:")+
theme_bw()+
theme(legend.position = "top",
axis.title = element_text(size = 16, face = "bold"),
axis.text = element_text(size = 12))+
facet_grid(Method ~ Condition,
labeller = labeller(
Method = method_names,
Condition = condition_names
))
log_facet
method_names <- c("BSQN" = "BSQN Normalization",
"cellhts2" = "CellHTS2 Normalization")
condition_names <- c("LN" = "Limited Nitrogen Condition",
"LS" = "Limited Sulfur Condition")
method_names <- c("BSQN" = "BSQN Normalization",
"Cellhts2" = "CellHTS2 Normalization")
condition_names <- c("LN" = "Limited Nitrogen Condition",
"LS" = "Limited Sulfur Condition")
log_facet <- final_plot_data %>%
filter(Method != "SD" ) %>%
ggplot(aes(x=SD_M, y = -log10(p), color = diffexpressed))+
geom_point(alpha = 0.8, size = 2)+
geom_text_repel(
data = subset(final_plot_data, (SD_M > 10 | SD_M < -10)&
(-log10(p) > -log10(0.05))),
aes(label = ORF),
size = 3,
fontface = "bold",
max.overlaps = Inf,
box.padding = 0.5,
show.legend = FALSE
) +
geom_hline(yintercept = -log10(0.05), linetype= "dashed", color = "black", linewidth = 0.5)+
geom_vline(xintercept = c(-1, 1), linetype = "dashed", color = "black", linewidth = 0.5)+
scale_color_manual(values = c("Down" = "#7D3560", "No" = "black", "Up" = "#4E7705" ))+
scale_y_continuous(
limits = c(-1, 8),
breaks = seq(-1, 8, by = 1),
minor_breaks = log_minor_breaks,
labels = math_format(10^.x))+
scale_x_continuous(
limits = c(-17, 17),
breaks = seq(-16, 16, by = 2),
minor_breaks = log2_minor_breaks) +
labs(x = "M value to Standard",
y = "-log10 p value",
color = "Expression status:")+
theme_bw()+
theme(legend.position = "top",
axis.title = element_text(size = 16, face = "bold"),
axis.text = element_text(size = 12))+
facet_grid(Method ~ Condition,
labeller = labeller(
Method = method_names,
Condition = condition_names
))
log_facet
