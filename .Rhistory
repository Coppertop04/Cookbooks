Verification_Data <- readxl::read_excel("C:/Users/dylan/Documents/R development/Heatmap/Copy of Verification Data.xlsx")
df_box <- Verification_Data[-c(1:288),]
delete_1 <- "_rep1$"
delete_2 <- "_rep2$"
delete_3 <- "_hr$"
df_box <- df_box %>%
select(-matches(delete_1), -matches(delete_2), -matches(delete_3))
df_box <- df_box[,-c(1)]
df_box <- df_box[1:10, 1:8]
df_box <- df_box %>%
rename_with(~ str_remove_all(., "^norm_"), everything()) %>%
rename_with(~ str_remove_all(., "_avg$"), everything())
df_box_1 <- df_box %>%
head(8)
df_bw <- df_box %>%
pivot_longer(cols = !c(1:2),
names_to = "conditions",
values_to = "abs")
df_bw_1 <- df_bw %>%
head(8)
kbl(df_bw_1, format = "simple", caption = "Truncated Table of Data")
library(tidyverse)
library(ggplot2)
library(kableExtra)
library(ggrepel)
library(here)
kbl(df_box_1, format = "simple", caption = "Table of Data")
df_bw <- df_box %>%
pivot_longer(cols = !c(1:2),
names_to = "conditions",
values_to = "abs")
df_bw_1 <- df_bw %>%
head(8)
kbl(df_bw_1, format = "simple", caption = "Truncated Table of Data")
ggplot(df_bw, aes(x = conditions, y = abs))+
geom_boxplot()
desired_order <- c("SD30", "SD37", "LN30", "LN37", "LS30", "LS37")
df_bw$conditions <- factor(df_bw$conditions, levels = desired_order)
df_bw %>%
ggplot(
aes(x = conditions, y = abs)
)+
geom_boxplot()+
geom_point()
View(df_box)
df_bw %>%
ggplot(aes(x=conditions, y=abs))+
geom_boxplot()+
geom_point(shape = 15)
df_bw_outlier <- df_bw %>%
group_by(conditions) %>%
mutate(
Q1 = quantile(abs, 0.25),
Q3 = quantile(abs, 0.75),
IQR = Q3 - Q1,
is_outlier = ifelse(abs < (Q1 - 1.5 * IQR) | abs > (Q3 + 1.5 * IQR), TRUE, FALSE)
) %>%
mutate(
label_text = ifelse(is_outlier, as.character(ver_pos), NA)
) %>%
ungroup()
View(df_bw)
