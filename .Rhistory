library(tidyverse)
library(ggplot2)
library(ggrepel)
library(ggthemes)
Pre_data %>%
ggplot(aes(x=Total_Points, y= Total_Confidence)) +
geom_smooth(color = "black", method = "loess", se= FALSE)+
geom_smooth(color = "grey", method = "lm", se = FALSE, linetype= "dashed")+
geom_point(color = "#f76800",size = 3)+
labs( x = "Competence", y = "Confidence")+
theme_test()+
theme(axis.text = element_text(size = 18, face = "bold"),
axis.title = element_text(size = 18, face = "bold"))
Pre_data %>%
ggplot(aes(x=Total_Points, y= Total_Confidence)) +
geom_smooth(color = "black", method = "loess", se= FALSE)+
geom_smooth(color = "grey20", method = "lm", se = FALSE, linetype= "dashed")+
geom_point(color = "#f76800",size = 3)+
labs( x = "Competence", y = "Confidence")+
theme_test()+
theme(axis.text = element_text(size = 18, face = "bold"),
axis.title = element_text(size = 18, face = "bold"))
plot_data %>%
ggplot(aes(x=Confidence, y=Numeric_Score)) +
geom_boxplot(fill = "grey80", color = "black", outlier.alpha =0,coef =0.5, width = 0.5, staplewidth = 0.5)+
geom_point(data = filter(plot_data, Outlier_Label != ""), color = "#f76800", size = 2, shape =15)+
geom_text_repel(
aes(label = Outlier_Label),
na.rm = TRUE,
box.padding=0.5,
point.padding=0.3,
segment.color = 'grey50',
size = 4
)+
stat_summary(fun = mean, geom = "point", shape = 18, size = 4, color = "black")+
scale_x_discrete(labels = c("C1" = "Graphing ability", "C2" = "Upload data", "C3" = "Creating tables", "C4" = "Debugging confidence", "C5" = "Error knowledge", "C6" = "Graphing confidence", "C7" = "Code competence"))+
theme_test()+
